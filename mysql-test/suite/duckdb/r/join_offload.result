SELECT /*+ SET_VAR(use_secondary_engine=FORCED) */ d.name, COUNT(*) AS c, SUM(f.amount) AS total
FROM fact f JOIN dim d ON f.dim_id = d.id
GROUP BY d.name
ORDER BY d.name;
