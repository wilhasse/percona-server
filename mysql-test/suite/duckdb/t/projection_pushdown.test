--source include/have_duckdb_plugin.inc

--disable_query_log
CALL mtr.add_suppression("DuckDB analytics node should run with read_only=ON");
CALL mtr.add_suppression("Got timeout reading communication packets");
CALL mtr.add_suppression("A message intended for a client cannot be sent");
--let $duckdb_installed=0
--let $duckdb_plugin_present=`SELECT COUNT(*) FROM INFORMATION_SCHEMA.PLUGINS WHERE PLUGIN_NAME='DUCKDB'`
--if ($duckdb_plugin_present == 0) {
  --eval INSTALL PLUGIN duckdb SONAME '$DUCKDB_PLUGIN';
  --let $duckdb_installed=1
}

SET @save_duckdb_execution_mode = @@GLOBAL.duckdb_execution_mode;
SET @@GLOBAL.duckdb_execution_mode = 'PRIMARY';
--enable_query_log

CREATE DATABASE duckdb_projection_pushdown;
USE duckdb_projection_pushdown;

CREATE TABLE t (
  id INT PRIMARY KEY,
  payload VARCHAR(64),
  metric INT,
  tag VARCHAR(64),
  notes VARCHAR(128)
) ENGINE=DUCKDB;

INSERT INTO t VALUES
  (1, 'alpha', 10, 'x', 'n1'),
  (2, 'beta',  20, 'y', 'n2'),
  (3, 'gamma', 30, 'z', 'n3'),
  (4, 'delta', 40, 'w', 'n4');

SELECT payload FROM t IGNORE INDEX (PRIMARY) WHERE metric >= 20 ORDER BY id;
SELECT payload, notes FROM t FORCE INDEX (PRIMARY) WHERE id BETWEEN 2 AND 4 ORDER BY id;
SELECT notes FROM t FORCE INDEX (PRIMARY) WHERE id = 3;
SELECT metric FROM t FORCE INDEX (PRIMARY) WHERE id > 2 ORDER BY id DESC LIMIT 2;

DROP DATABASE duckdb_projection_pushdown;

--disable_query_log
SET @@GLOBAL.duckdb_execution_mode = @save_duckdb_execution_mode;
--if ($duckdb_installed == 1) {
  UNINSTALL PLUGIN duckdb;
}
--enable_query_log
